{
  "name": "opencode-sandbox",
  "version": "0.6.0",
  "description": "OpenCode 2 plugin that sandboxes agent commands using @anthropic-ai/sandbox-runtime (seatbelt on macOS, bubblewrap on Linux)",
  "engines": {
    "opencode": ">=2.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/tui.tsx --outdir dist --target node --format esm --external @anthropic-ai/sandbox-runtime --external @opencode/plugin --external '@opencode/plugin/*' --external @opentui/core --external '@opentui/*' --external solid-js && bun x tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sandbox",
    "security",
    "anthropic",
    "seatbelt",
    "bubblewrap",
    "agent-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isanchez31/opencode-sandbox-plugin.git"
  },
  "homepage": "https://github.com/isanchez31/opencode-sandbox-plugin#readme",
  "bugs": {
    "url": "https://github.com/isanchez31/opencode-sandbox-plugin/issues"
  },
  "author": "Ivan Sanchez <ivan31.sanchez@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode/plugin": "2.0.22",
    "@opencode/theme": "^2.0.22",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/bun": "^1.3.9",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  }
}
